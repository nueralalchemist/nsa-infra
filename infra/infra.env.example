# Shared settings for the SHELL edition. Copy to infra/infra.env (git-ignored).
# The Ansible edition reads the same settings from ansible/group_vars/all.yml
# (each NSA_FOO below is nsa_foo there).
#
# Plain KEY=VALUE only: the file is parsed, never executed.
# Secrets (TAILSCALE_AUTHKEY) are better passed as environment variables than written here.

# --- Reachability of the gateway --------------------------------------------------
# tailscale : gateway binds to the Tailscale IP only. Needs TAILSCALE_AUTHKEY on first run.
# localhost : gateway binds to 127.0.0.1; reach it from WSL through an SSH tunnel.
NSA_EXPOSE=tailscale
NSA_GATEWAY_PORT=4000
NSA_TS_HOSTNAME=nsa-cloud

# --- Models served by the gateway (names must match NSA_MODEL_*_CLOUD in the client's .env) ---
# Moving to bigger infra = change these two lines and re-run the installer.
# qwen3:4b-instruct is NON-thinking. Plain qwen3:4b is thinking-only: on 4 CPU cores it burned a 4096-token budget
# on reasoning for 3.5 minutes and returned nothing. One model for both aliases also avoids reloads on a small box.
NSA_MODEL_MAIN_CLOUD=qwen3:4b-instruct
NSA_MODEL_FAST_CLOUD=qwen3:4b-instruct
# Extra *chat* models to pull and serve, space separated (optional)
NSA_EXTRA_MODELS=

# --- Ollama tuning (CPU box defaults: one model at a time, one request at a time) ---
NSA_OLLAMA_KEEP_ALIVE=10m
NSA_OLLAMA_MAX_LOADED=1
NSA_OLLAMA_NUM_PARALLEL=1

# --- Supply-chain pins ---
# Empty LITELLM_VERSION installs the latest and prints a warning. Pin after Phase 5 validation.
NSA_LITELLM_VERSION=
# If set, the downloaded installer is refused unless its sha256 matches.
NSA_OLLAMA_INSTALL_SHA256=

# --- Minimum free disk (GB) required on / before installing ---
NSA_MIN_DISK_GB=10
