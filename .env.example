# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- Local endpoint (Ollama's OpenAI-compatible API, or a local LiteLLM gateway) ---
NSA_LOCAL_URL=http://localhost:11434/v1
NSA_LOCAL_KEY=ollama

# --- Cloud endpoint (LiteLLM gateway on your cloud box, reached over Tailscale/WireGuard) ---
# Leave empty to disable cloud mode.
NSA_CLOUD_URL=
NSA_CLOUD_KEY=

# --- Model names per alias/mode. Upgrading infra = change these (or config/models.yaml). ---
NSA_MODEL_MAIN_LOCAL=qwen3:8b
NSA_MODEL_MAIN_CLOUD=qwen3:4b-instruct
NSA_MODEL_FAST_LOCAL=qwen3:8b
NSA_MODEL_FAST_CLOUD=qwen3:4b-instruct

# Seconds to wait for one model response (raise on CPU-only machines)
NSA_LLM_TIMEOUT=300

# Hidden reasoning per alias and mode: empty = the model's default, "none" = off.
# "none" only works for models that can toggle thinking (qwen3:8b). A thinking-only model such as qwen3:4b CANNOT be
# switched off: with "none" its raw reasoning leaks into the answer. Leave the cloud values empty for qwen3:4b.
NSA_MAIN_REASONING_LOCAL=
NSA_MAIN_REASONING_CLOUD=
NSA_FAST_REASONING_LOCAL=none
NSA_FAST_REASONING_CLOUD=

# --- Safety ---
# Redaction applied to every prompt sent to the cloud endpoint: standard | strict | off
NSA_REDACT=standard
# Extra directories agents may read, besides the current directory (colon separated)
NSA_ALLOWED_PATHS=
